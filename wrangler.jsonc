{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ztools",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },
  "routes": [
    {
      "pattern": "ztools.lxzt.fun",
      "custom_domain": true
    }
  ]
}
