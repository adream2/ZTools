# 复制为 .env.local 后按需填写；不填的项会自动跳过，不会渲染空标签

# ---- 站长平台验证（填平台给的 content 值）----
# Google Search Console → HTML 标记方式
VITE_VERIFY_GOOGLE=
# Bing Webmaster Tools
VITE_VERIFY_BING=
# 百度搜索资源平台
VITE_VERIFY_BAIDU=
# 搜狗站长平台
VITE_VERIFY_SOGOU=
# 360 站长平台
VITE_VERIFY_360=
# Yandex Webmaster
VITE_VERIFY_YANDEX=

# ---- Google AdSense ----
# 发布商 ID，形如 ca-pub-1234567890123456；填了才会加载广告脚本并生成 ads.txt
VITE_ADSENSE_CLIENT=
# 各广告位对应的广告单元 slot id（纯数字，AdSense 后台创建后获得）
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_TOOL=
VITE_ADSENSE_SLOT_CATEGORY=

# ---- 部署 ----
# GitHub Pages 子路径部署时填写仓库名，例如 /WebTools/
VITE_BASE=
