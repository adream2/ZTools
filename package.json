{
  "name": "zttools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯静态中文在线工具箱，支持 PWA，可部署到 Cloudflare Workers / EdgeOne Pages / GitHub Pages",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/validate-tools.mjs && node scripts/check-styles.mjs && node scripts/check-dist.mjs",
    "verify:meta": "node scripts/validate-tools.mjs",
    "verify:styles": "node scripts/check-styles.mjs",
    "verify:browser": "node scripts/check-tools.mjs",
    "codemod:clay": "node scripts/codemod-clay.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "deploy:cf": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "croner": "^11.0.0",
    "cronstrue": "^3.38.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lunar-javascript": "^1.7.8",
    "marked": "^18.1.3",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.5",
    "spark-md5": "^3.0.2",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
